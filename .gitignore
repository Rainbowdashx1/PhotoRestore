# Salidas de compilación .NET
bin/
obj/

# Entorno virtual de Python usado solo para inspeccionar/convertir el modelo
.venv/

# Nota: PhotoRestore/wwwroot/models/realesrgan-x4.onnx (~5 MB) se incluye en el
# prototipo para que funcione tal cual; si el modelo creciera, convendría
# excluirlo de git y alojarlo aparte.
# Archivos del IDE
.vs/
*.user

# Modelos grandes: no caben en GitHub ni en un despliegue estático. El navegador
# los descarga una vez (Cache Storage) desde ./models/ o desde HuggingFace
# (ver PhotoRestore/wwwroot/js/model-loader.js). Para desarrollo local se
# descargan a mano con las URLs de PhotoRestore/wwwroot/models/README.md.
PhotoRestore/wwwroot/models/gfpgan-v1.4.onnx
PhotoRestore/wwwroot/models/ddcolor.onnx
PhotoRestore/wwwroot/models/rmbg-1.4.onnx
PhotoRestore/models-backup/
