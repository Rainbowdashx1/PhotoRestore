@page "/"
@page "/restore"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Photo Labs — Restauración de fotos con IA</PageTitle>

<div class="hero">
    <h1>Photo Labs</h1>
    <p class="hero-sub">
        Restauración de fotos con IA, directamente en tu navegador.
        Sin servidores: tu imagen nunca sale de tu dispositivo.
    </p>
</div>

<div class="glass-card anim-enter">
    <div class="dropzone" @ref="dropzoneRef">
        <InputFile class="dropzone-input" OnChange="CargarImagen" accept="image/*" title="Selecciona una imagen" />
        <svg class="dz-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
        </svg>
        @if (imagenNombre is not null && imagenBytes is not null)
        {
            <div class="dz-preview fade-in">
                @if (originalUrl is not null)
                {
                    <img class="dz-thumb" src="@originalUrl" alt="Vista previa de la imagen seleccionada" />
                }
                <div class="dz-info">
                    <p class="dz-file">@imagenNombre</p>
                    <span class="dz-hint">@imagenAncho × @imagenAlto px · haz clic o suelta otra imagen para cambiar</span>
                </div>
            </div>
        }
        else
        {
            <p>Arrastra una imagen o haz clic para seleccionar</p>
            <span class="dz-hint">PNG, JPG, WebP… hasta 25 MB</span>
        }
    </div>
</div>

<div class="glass-card anim-enter">
    <span class="card-label">Quitar fondo y añadir sombra</span>
    <div class="mode-cards">
        <label class="mode-card @(modo == "fondo" ? "active" : "") @(ocupado ? "disabled" : "")">
            <input type="radio" name="modo" value="fondo" checked="@(modo == "fondo")"
                   disabled="@ocupado" @onchange='() => modo = "fondo"' />
            <div class="mode-head">
                <span class="mode-title">Quitar fondo</span>
                <span class="mode-model">RMBG-1.4</span>
            </div>
            <p class="mode-desc">
                Detecta el sujeto principal y elimina el fondo automáticamente.
                Devuelve un PNG con transparencia, en el tamaño original.
                <a class="mode-doc" href="https://huggingface.co/briaai/RMBG-1.4" target="_blank"
                   rel="noopener noreferrer" @onclick:stopPropagation>Documentación oficial ↗</a>
            </p>
        </label>
        <label class="mode-card @(modo == "fondopro" ? "active" : "") @(ocupado ? "disabled" : "")">
            <input type="radio" name="modo" value="fondopro" checked="@(modo == "fondopro")"
                   disabled="@ocupado" @onchange='() => modo = "fondopro"' />
            <div class="mode-head">
                <span class="mode-title">Quitar fondo Pro</span>
                <span class="mode-model">BiRefNet</span>
            </div>
            <p class="mode-desc">
                Máxima calidad en bordes difíciles (pelo, velos, semitransparencias).
                Modelo pesado (~185 MB la primera vez); recomendado con WebGPU.
                <a class="mode-doc" href="https://github.com/ZhengPeng7/BiRefNet" target="_blank"
                   rel="noopener noreferrer" @onclick:stopPropagation>Documentación oficial ↗</a>
            </p>
        </label>
        <label class="mode-card @(modo == "fondomax" ? "active" : "") @(ocupado ? "disabled" : "")">
            <input type="radio" name="modo" value="fondomax" checked="@(modo == "fondomax")"
                   disabled="@ocupado" @onchange='() => modo = "fondomax"' />
            <div class="mode-head">
                <span class="mode-title">Quitar fondo Pro Max</span>
                <span class="mode-model">BiRefNet 1024</span>
                <span class="mode-badge">Experimental</span>
            </div>
            <p class="mode-desc">
                Igual que Pro pero con la máscara calculada a 1024×1024: más detalle fino.
                Necesita mucha memoria (~9 GB); puede fallar en equipos modestos.
                <a class="mode-doc" href="https://huggingface.co/onnx-community/BiRefNet_lite-ONNX" target="_blank"
                   rel="noopener noreferrer" @onclick:stopPropagation>Documentación oficial ↗</a>
            </p>
        </label>
        <label class="mode-card @(modo == "sombra" ? "active" : "") @(ocupado ? "disabled" : "")">
            <input type="radio" name="modo" value="sombra" checked="@(modo == "sombra")"
                   disabled="@ocupado" @onchange='() => modo = "sombra"' />
            <div class="mode-head">
                <span class="mode-title">Añadir sombra</span>
                <span class="mode-model">RMBG-1.4 + sintética</span>
            </div>
            <p class="mode-desc">
                Quita el fondo y añade una sombra de caída configurable
                (ángulo, distancia, difuminado, opacidad) sobre fondo blanco o
                transparente. Los ajustes se aplican al instante, sin reprocesar.
            </p>
        </label>
    </div>
</div>

<div class="glass-card anim-enter">
    <span class="card-label">Mejorar imagen</span>
    <div class="mode-cards">
        <label class="mode-card @(modo == "general" ? "active" : "") @(ocupado ? "disabled" : "")">
            <input type="radio" name="modo" value="general" checked="@(modo == "general")"
                   disabled="@ocupado" @onchange='() => modo = "general"' />
            <div class="mode-head">
                <span class="mode-title">General</span>
                <span class="mode-model">Real-ESRGAN</span>
            </div>
            <p class="mode-desc">
                Mejora la nitidez y aumenta la resolución (hasta x4).
                Úsalo para fotos pixeladas, comprimidas o de baja calidad.
                <a class="mode-doc" href="https://github.com/xinntao/Real-ESRGAN" target="_blank"
                   rel="noopener noreferrer" @onclick:stopPropagation>Documentación oficial ↗</a>
            </p>
        </label>
        <label class="mode-card @(modo == "caras" ? "active" : "") @(ocupado ? "disabled" : "")">
            <input type="radio" name="modo" value="caras" checked="@(modo == "caras")"
                   disabled="@ocupado" @onchange='() => modo = "caras"' />
            <div class="mode-head">
                <span class="mode-title">Caras</span>
                <span class="mode-model">GFPGAN</span>
            </div>
            <p class="mode-desc">
                Restaura rostros dañados o desenfocados.
                Ideal para fotos antiguas y retratos; mantiene el tamaño original.
                <a class="mode-doc" href="https://github.com/TencentARC/GFPGAN" target="_blank"
                   rel="noopener noreferrer" @onclick:stopPropagation>Documentación oficial ↗</a>
            </p>
        </label>
    </div>
</div>

<div class="glass-card anim-enter">
    <span class="card-label">Colorizar</span>
    <div class="mode-cards">
        <label class="mode-card @(modo == "colorizar" ? "active" : "") @(ocupado ? "disabled" : "")">
            <input type="radio" name="modo" value="colorizar" checked="@(modo == "colorizar")"
                   disabled="@ocupado" @onchange='() => modo = "colorizar"' />
            <div class="mode-head">
                <span class="mode-title">Colorizar</span>
                <span class="mode-model">DDColor</span>
            </div>
            <p class="mode-desc">
                Da color a fotos en blanco y negro, manteniendo el tamaño original.
                Úsalo solo con imágenes en escala de grises.
                <a class="mode-doc" href="https://github.com/piddnad/DDColor" target="_blank"
                   rel="noopener noreferrer" @onclick:stopPropagation>Documentación oficial ↗</a>
            </p>
        </label>
    </div>
</div>

@if (modo == "general")
{
    <div class="glass-card anim-enter">
        <span class="card-label">Factor de salida</span>
        <div class="scale-pills">
            @foreach (var f in new[] { 1, 2, 4 })
            {
                var valor = f;
                <label class="pill @(factor == valor ? "active" : "") @(ocupado ? "disabled" : "")">
                    <input type="radio" name="factor" value="@valor" checked="@(factor == valor)"
                           disabled="@ocupado" @onchange="() => factor = valor" />
                    @EtiquetaFactor(valor)
                </label>
            }
        </div>
        @if (imagenAncho > 0)
        {
            <p class="output-hint">Salida: <strong>@(imagenAncho * factor) × @(imagenAlto * factor) px</strong></p>
        }
    </div>
}

@if (modo == "sombra")
{
    <div class="glass-card anim-enter">
        <span class="card-label">Sombra</span>
        <div class="shadow-controls">
            <label class="slider-row">
                <span class="slider-name">Ángulo</span>
                <input type="range" min="0" max="360" value="@sombraAngulo" disabled="@ocupado"
                       @oninput="e => CambiarSombra(e, v => sombraAngulo = v)" />
                <span class="slider-val">@sombraAngulo°</span>
            </label>
            <label class="slider-row">
                <span class="slider-name">Distancia</span>
                <input type="range" min="0" max="200" value="@sombraDistancia" disabled="@ocupado"
                       @oninput="e => CambiarSombra(e, v => sombraDistancia = v)" />
                <span class="slider-val">@sombraDistancia px</span>
            </label>
            <label class="slider-row">
                <span class="slider-name">Difuminado</span>
                <input type="range" min="0" max="100" value="@sombraDifuminado" disabled="@ocupado"
                       @oninput="e => CambiarSombra(e, v => sombraDifuminado = v)" />
                <span class="slider-val">@sombraDifuminado px</span>
            </label>
            <label class="slider-row">
                <span class="slider-name">Opacidad</span>
                <input type="range" min="0" max="100" value="@sombraOpacidad" disabled="@ocupado"
                       @oninput="e => CambiarSombra(e, v => sombraOpacidad = v)" />
                <span class="slider-val">@sombraOpacidad %</span>
            </label>
        </div>
        <div class="scale-pills shadow-bg-pills">
            <label class="pill @(sombraFondo == "blanco" ? "active" : "") @(ocupado ? "disabled" : "")">
                <input type="radio" name="sombraFondo" value="blanco" checked="@(sombraFondo == "blanco")"
                       disabled="@ocupado" @onchange='() => CambiarFondoSombra("blanco")' />
                Fondo blanco
            </label>
            <label class="pill @(sombraFondo == "transparente" ? "active" : "") @(ocupado ? "disabled" : "")">
                <input type="radio" name="sombraFondo" value="transparente" checked="@(sombraFondo == "transparente")"
                       disabled="@ocupado" @onchange='() => CambiarFondoSombra("transparente")' />
                Transparente (PNG)
            </label>
        </div>
    </div>
}

<button class="btn-restore" @onclick="Restaurar" disabled="@(imagenBytes is null || ocupado)">
    @(ocupado ? "Procesando…" : TextoBoton)
</button>

@if (ocupado)
{
    <div class="glass-card processing-card fade-in">
        <lottie-player src="lottie/loading.json" autoplay loop
                       style="width: 140px; height: 105px;"></lottie-player>
        <p class="status-text" role="status">@estado</p>
        @if (tilesTotal > 0)
        {
            <div class="progress-track">
                <div class="progress-fill" style="width: @(100 * tilesDone / tilesTotal)%"></div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="glass-card error-card fade-in">@error</div>
}

@if (!string.IsNullOrEmpty(info))
{
    <div class="glass-card fade-in" style="color: var(--text-muted);">@info</div>
}

@if (resultUrl is not null && originalUrl is not null)
{
    <div class="glass-card result-card fade-in">
        <span class="card-label">Resultado</span>
        <div class="comparison-wrap">
            <img-comparison-slider @ref="sliderRef">
                <img slot="first" src="@originalUrl" alt="Imagen original" />
                <img slot="second" src="@resultUrl" alt="Imagen restaurada" />
                <div slot="handle" class="cmp-handle" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 6 4 12 9 18" />
                        <polyline points="15 6 20 12 15 18" />
                    </svg>
                </div>
            </img-comparison-slider>
            <span class="cmp-label before">Antes</span>
            <span class="cmp-label after">Después</span>
        </div>
        <p class="result-meta">
            <strong>@resultWidth × @resultHeight px</strong> · x@factor
            @if (!string.IsNullOrEmpty(backend))
            {
                <span class="backend-badge @(backend == "webgpu" ? "webgpu" : "")">
                    Motor: @(backend == "webgpu" ? "WebGPU" : "WASM (CPU)")
                </span>
            }
        </p>
        <a class="btn-download" href="@resultUrl" download="@NombreDescarga">Descargar resultado</a>
    </div>
}

<footer class="page-footer">
    Tu imagen nunca sale de tu dispositivo · Real-ESRGAN · GFPGAN · DDColor · RMBG-1.4 · BiRefNet · ONNX Runtime Web
</footer>

@code {
    private const long MaxFileSize = 25 * 1024 * 1024; // 25 MB

    private IJSObjectReference? module;
    private IJSObjectReference? faceModule;
    private IJSObjectReference? colorModule;
    private IJSObjectReference? bgModule;
    private IJSObjectReference? bgProModule;
    private IJSObjectReference? uiModule;
    private DotNetObjectReference<Restore>? progressRef;
    private ElementReference dropzoneRef;
    private ElementReference sliderRef;
    private bool hintPendiente;

    private byte[]? imagenBytes;
    private string? imagenMime;
    private string? imagenNombre;
    private int imagenAncho;
    private int imagenAlto;
    private string modo = "general"; // "general" (Real-ESRGAN) | "caras" (GFPGAN) | "colorizar" (DDColor) | "fondo" (RMBG-1.4) | "fondopro" (BiRefNet 512) | "fondomax" (BiRefNet 1024) | "sombra" (RMBG-1.4 + sombra sintética)
    private int factor = 1;
    private int sombraAngulo = 45;
    private int sombraDistancia = 25;
    private int sombraDifuminado = 30;
    private int sombraOpacidad = 60;
    private string sombraFondo = "blanco"; // "blanco" | "transparente"
    private string? originalUrl;
    private string? resultUrl;
    private int resultWidth;
    private int resultHeight;
    private string? backend;
    private string? estado;
    private string? error;
    private string? info;
    private int tilesDone;
    private int tilesTotal;
    private bool ocupado;

    private string NombreDescarga =>
        $"{Path.GetFileNameWithoutExtension(imagenNombre ?? "imagen")}-{SufijoDescarga}.png";

    private string SufijoDescarga => modo switch
    {
        "caras" => "caras",
        "colorizar" => "color",
        "fondo" => "sin-fondo",
        "fondopro" => "sin-fondo-pro",
        "fondomax" => "sin-fondo-max",
        "sombra" => "con-sombra",
        _ => $"x{factor}"
    };

    // Texto del botón principal según la acción real de cada modo.
    private string TextoBoton => modo switch
    {
        "caras" => "Restaurar caras",
        "colorizar" => "Colorizar foto",
        "fondo" => "Quitar fondo",
        "fondopro" => "Quitar fondo",
        "fondomax" => "Quitar fondo",
        "sombra" => "Añadir sombra",
        _ => "Restaurar"
    };

    private static string EtiquetaFactor(int f) => f switch
    {
        1 => "x1 · mismo tamaño",
        2 => "x2",
        _ => "x4 · máximo detalle"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/upscaler.js");
            faceModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/face-restore.js");
            colorModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/colorize.js");
            bgModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/remove-bg.js");
            bgProModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/remove-bg-birefnet.js");
            uiModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
            progressRef = DotNetObjectReference.Create(this);

            await uiModule.InvokeVoidAsync("initAnimations");
            await uiModule.InvokeVoidAsync("initDropzone", dropzoneRef);
        }

        // El comparador acaba de aparecer: animación "hint" una sola vez.
        if (hintPendiente && resultUrl is not null && uiModule is not null)
        {
            hintPendiente = false;
            await uiModule.InvokeVoidAsync("hintComparison", sliderRef);
        }
    }

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        error = null;
        info = null;
        resultUrl = null;
        backend = null;
        estado = null;
        imagenBytes = null;
        imagenNombre = null;
        imagenAncho = 0;
        imagenAlto = 0;

        var file = e.File;
        if (!file.ContentType.StartsWith("image/"))
        {
            error = "Formato no soportado: selecciona un archivo de imagen.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            imagenBytes = ms.ToArray();
            imagenMime = file.ContentType;
            imagenNombre = file.Name;

            if (module is not null)
            {
                if (originalUrl is not null)
                    await module.InvokeVoidAsync("revokeObjectUrl", originalUrl);
                originalUrl = await module.InvokeAsync<string>("createObjectUrl", imagenBytes, imagenMime);

                var size = await module.InvokeAsync<ImageSize>("getImageSize", imagenBytes, imagenMime);
                imagenAncho = size.Width;
                imagenAlto = size.Height;
            }
        }
        catch (Exception ex)
        {
            error = $"No se pudo leer la imagen: {ex.Message}";
            imagenBytes = null;
            imagenNombre = null;
        }
    }

    private async Task Restaurar()
    {
        if (progressRef is null || imagenBytes is null)
            return;

        ocupado = true;
        error = null;
        info = null;
        resultUrl = null;
        tilesDone = 0;
        tilesTotal = 0;

        try
        {
            if (modo == "caras")
            {
                await RestaurarCaras();
            }
            else if (modo == "fondo")
            {
                if (bgModule is null) return;
                estado = "Cargando modelo RMBG-1.4 (~168 MB la primera vez)…";
                var result = await bgModule.InvokeAsync<UpscaleResult>("removeBackground", imagenBytes, imagenMime, progressRef);
                resultUrl = result.ResultUrl;
                backend = result.Backend;
                resultWidth = result.Width;
                resultHeight = result.Height;
                info = "Fondo eliminado. El PNG descargado conserva la transparencia.";
                hintPendiente = true;
            }
            else if (modo == "fondopro")
            {
                if (bgProModule is null) return;
                estado = "Cargando modelo BiRefNet (~185 MB la primera vez)…";
                var result = await bgProModule.InvokeAsync<UpscaleResult>("removeBackgroundBiRefNet", imagenBytes, imagenMime, progressRef);
                resultUrl = result.ResultUrl;
                backend = result.Backend;
                resultWidth = result.Width;
                resultHeight = result.Height;
                info = "Fondo eliminado con BiRefNet. El PNG descargado conserva la transparencia.";
                hintPendiente = true;
            }
            else if (modo == "fondomax")
            {
                if (bgProModule is null) return;
                estado = "Cargando modelo BiRefNet 1024 (~214 MB la primera vez)…";
                var result = await bgProModule.InvokeAsync<UpscaleResult>("removeBackgroundBiRefNetMax", imagenBytes, imagenMime, progressRef);
                resultUrl = result.ResultUrl;
                backend = result.Backend;
                resultWidth = result.Width;
                resultHeight = result.Height;
                info = "Fondo eliminado con BiRefNet a 1024×1024. El PNG descargado conserva la transparencia.";
                hintPendiente = true;
            }
            else if (modo == "sombra")
            {
                if (bgModule is null) return;
                estado = "Cargando modelo RMBG-1.4 (~168 MB la primera vez)…";
                var result = await bgModule.InvokeAsync<UpscaleResult>("addShadow", imagenBytes, imagenMime, progressRef, ParametrosSombra());
                resultUrl = result.ResultUrl;
                backend = result.Backend;
                resultWidth = result.Width;
                resultHeight = result.Height;
                info = "Sombra añadida. Mueve los controles para retocarla al instante, sin recalcular.";
                hintPendiente = true;
            }
            else if (modo == "colorizar")
            {
                if (colorModule is null) return;
                estado = "Cargando modelo DDColor (~258 MB la primera vez)…";
                var result = await colorModule.InvokeAsync<UpscaleResult>("colorize", imagenBytes, imagenMime, progressRef);
                resultUrl = result.ResultUrl;
                backend = result.Backend;
                resultWidth = result.Width;
                resultHeight = result.Height;
                info = "Foto colorizada. La luminancia se conserva; el color es una estimación del modelo.";
                hintPendiente = true;
            }
            else
            {
                if (module is null) return;
                estado = "Cargando modelo Real-ESRGAN…";
                var result = await module.InvokeAsync<UpscaleResult>("upscale", imagenBytes, imagenMime, progressRef, factor);
                resultUrl = result.ResultUrl;
                backend = result.Backend;
                resultWidth = result.Width;
                resultHeight = result.Height;
                hintPendiente = true;
            }
        }
        catch (Exception ex)
        {
            error = $"Error durante la restauración: {ex.Message}";
        }
        finally
        {
            ocupado = false;
            estado = null;
        }
    }

    private async Task RestaurarCaras()
    {
        if (faceModule is null) return;
        estado = "Cargando modelos de restauración de caras (~340 MB la primera vez)…";
        var result = await faceModule.InvokeAsync<FaceResult>("restoreFaces", imagenBytes, imagenMime, progressRef);
        if (result.ResultUrl is null)
        {
            info = "No se detectaron caras en la imagen. Prueba con el modo General o con otra foto.";
            return;
        }
        resultUrl = result.ResultUrl;
        backend = result.Backend;
        resultWidth = result.Width;
        resultHeight = result.Height;
        info = result.Faces == 1 ? "Se restauró 1 cara." : $"Se restauraron {result.Faces} caras.";
        hintPendiente = true;
    }

    private object ParametrosSombra() => new
    {
        angulo = sombraAngulo,
        distancia = sombraDistancia,
        difuminado = sombraDifuminado,
        opacidad = sombraOpacidad,
        fondo = sombraFondo
    };

    private async Task CambiarSombra(ChangeEventArgs e, Action<int> aplicar)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        aplicar(v);
        await ActualizarSombra();
    }

    private async Task CambiarFondoSombra(string fondo)
    {
        sombraFondo = fondo;
        await ActualizarSombra();
    }

    // Recompone la sombra con los parámetros actuales reutilizando el recorte
    // que addShadow dejó cacheado en JS: no vuelve a ejecutar el modelo.
    private async Task ActualizarSombra()
    {
        if (modo != "sombra" || resultUrl is null || bgModule is null || ocupado)
            return;
        try
        {
            var result = await bgModule.InvokeAsync<UpscaleResult>("updateShadow", ParametrosSombra());
            resultUrl = result.ResultUrl;
            resultWidth = result.Width;
            resultHeight = result.Height;
        }
        catch (Exception ex)
        {
            error = $"No se pudo actualizar la sombra: {ex.Message}";
        }
    }

    [JSInvokable]
    public void OnTileDone(int done, int total)
    {
        tilesDone = done;
        tilesTotal = total;
        estado = $"Procesando tile {done} de {total}";
        StateHasChanged();
    }

    [JSInvokable]
    public void OnEstado(string texto)
    {
        estado = texto;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCaraDone(int done, int total)
    {
        tilesDone = done;
        tilesTotal = total;
        estado = $"Restaurando cara {done} de {total}";
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        progressRef?.Dispose();
        try
        {
            if (module is not null)
            {
                if (originalUrl is not null)
                    await module.InvokeVoidAsync("revokeObjectUrl", originalUrl);
                await module.DisposeAsync();
            }
            if (faceModule is not null)
                await faceModule.DisposeAsync();
            if (colorModule is not null)
                await colorModule.DisposeAsync();
            if (bgModule is not null)
                await bgModule.DisposeAsync();
            if (bgProModule is not null)
                await bgProModule.DisposeAsync();
            if (uiModule is not null)
                await uiModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // El circuito/JS ya no está disponible al cerrar la página.
        }
    }

    private sealed class ImageSize
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }

    private sealed class UpscaleResult
    {
        public string ResultUrl { get; set; } = "";
        public string Backend { get; set; } = "";
        public int Width { get; set; }
        public int Height { get; set; }
    }

    private sealed class FaceResult
    {
        public string? ResultUrl { get; set; }
        public string Backend { get; set; } = "";
        public int Width { get; set; }
        public int Height { get; set; }
        public int Faces { get; set; }
    }
