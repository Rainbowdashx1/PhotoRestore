@page "/"
@page "/restore"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Restaurar</PageTitle>

<h1>Restaurar imagen</h1>

<p>
    Restaura y amplía imágenes con Real-ESRGAN usando ONNX Runtime Web.
    El modelo procesa internamente a 4x y ajusta la salida al factor elegido.
    Todo el procesamiento ocurre en tu navegador: la imagen nunca sale de tu dispositivo.
</p>

<div class="mb-3" style="max-width: 32rem;">
    <label class="form-label">Selecciona una imagen</label>
    <InputFile class="form-control" OnChange="CargarImagen" accept="image/*" />
</div>

<div class="mb-3" style="max-width: 32rem;">
    <label class="form-label" for="factor">Factor de salida</label>
    <InputSelect id="factor" class="form-select" @bind-Value="factor" disabled="@ocupado">
        <option value="1">x1 (restaurar, mismo tamaño)</option>
        <option value="2">x2</option>
        <option value="4">x4 (máximo detalle)</option>
    </InputSelect>
    @if (imagenAncho > 0)
    {
        <div class="form-text">Salida: @(imagenAncho * factor) × @(imagenAlto * factor)</div>
    }
</div>

<button class="btn btn-primary mb-3" @onclick="Restaurar" disabled="@(imagenBytes is null || ocupado)">
    @(ocupado ? "Procesando…" : "Restaurar")
</button>

@if (!string.IsNullOrEmpty(estado))
{
    <p role="status">@estado</p>
    @if (tilesTotal > 0)
    {
        <div class="progress mb-3" style="max-width: 32rem;">
            <div class="progress-bar" role="progressbar"
                 style="width: @(100 * tilesDone / tilesTotal)%"
                 aria-valuenow="@tilesDone" aria-valuemin="0" aria-valuemax="@tilesTotal"></div>
        </div>
    }
}

@if (!string.IsNullOrEmpty(backend))
{
    <p>Motor: <strong>@(backend == "webgpu" ? "WebGPU" : "WASM (CPU)")</strong></p>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" style="max-width: 32rem;">@error</div>
}

@if (originalUrl is not null || resultUrl is not null)
{
    <div class="row">
        @if (originalUrl is not null)
        {
            <div class="col-md-6 mb-3">
                <h5>Original</h5>
                <img src="@originalUrl" class="img-fluid border" alt="Imagen original" />
            </div>
        }
        @if (resultUrl is not null)
        {
            <div class="col-md-6 mb-3">
                <h5>Resultado (@resultWidth × @resultHeight)</h5>
                <img src="@resultUrl" class="img-fluid border" alt="Imagen restaurada" />
                <div class="mt-2">
                    <a class="btn btn-success" href="@resultUrl" download="@NombreDescarga">Descargar resultado</a>
                </div>
            </div>
        }
    </div>
}

@code {
    private const long MaxFileSize = 25 * 1024 * 1024; // 25 MB

    private IJSObjectReference? module;
    private DotNetObjectReference<Restore>? progressRef;

    private byte[]? imagenBytes;
    private string? imagenMime;
    private string? imagenNombre;
    private int imagenAncho;
    private int imagenAlto;
    private int factor = 1;
    private string? originalUrl;
    private string? resultUrl;
    private int resultWidth;
    private int resultHeight;
    private string? backend;
    private string? estado;
    private string? error;
    private int tilesDone;
    private int tilesTotal;
    private bool ocupado;

    private string NombreDescarga =>
        $"{Path.GetFileNameWithoutExtension(imagenNombre ?? "imagen")}-x{factor}.png";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/upscaler.js");
            progressRef = DotNetObjectReference.Create(this);
        }
    }

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        error = null;
        resultUrl = null;
        backend = null;
        estado = null;
        imagenBytes = null;
        imagenAncho = 0;
        imagenAlto = 0;

        var file = e.File;
        if (!file.ContentType.StartsWith("image/"))
        {
            error = "Formato no soportado: selecciona un archivo de imagen.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            imagenBytes = ms.ToArray();
            imagenMime = file.ContentType;
            imagenNombre = file.Name;

            if (module is not null)
            {
                if (originalUrl is not null)
                    await module.InvokeVoidAsync("revokeObjectUrl", originalUrl);
                originalUrl = await module.InvokeAsync<string>("createObjectUrl", imagenBytes, imagenMime);

                var size = await module.InvokeAsync<ImageSize>("getImageSize", imagenBytes, imagenMime);
                imagenAncho = size.Width;
                imagenAlto = size.Height;
            }
        }
        catch (Exception ex)
        {
            error = $"No se pudo leer la imagen: {ex.Message}";
            imagenBytes = null;
        }
    }

    private async Task Restaurar()
    {
        if (module is null || progressRef is null || imagenBytes is null)
            return;

        ocupado = true;
        error = null;
        resultUrl = null;
        tilesDone = 0;
        tilesTotal = 0;
        estado = "Cargando modelo Real-ESRGAN…";

        try
        {
            var result = await module.InvokeAsync<UpscaleResult>("upscale", imagenBytes, imagenMime, progressRef, factor);
            resultUrl = result.ResultUrl;
            backend = result.Backend;
            resultWidth = result.Width;
            resultHeight = result.Height;
            estado = "Completado.";
        }
        catch (Exception ex)
        {
            error = $"Error durante la restauración: {ex.Message}";
            estado = null;
        }
        finally
        {
            ocupado = false;
        }
    }

    [JSInvokable]
    public void OnTileDone(int done, int total)
    {
        tilesDone = done;
        tilesTotal = total;
        estado = $"Procesando tile {done} de {total}";
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        progressRef?.Dispose();
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito/JS ya no está disponible al cerrar la página.
            }
        }
    }

    private sealed class ImageSize
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }

    private sealed class UpscaleResult
    {
        public string ResultUrl { get; set; } = "";
        public string Backend { get; set; } = "";
        public int Width { get; set; }
        public int Height { get; set; }
    }
}
