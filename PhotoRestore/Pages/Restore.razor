@page "/"
@page "/restore"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PhotoRestore — Restauración de fotos con IA</PageTitle>

<div class="hero">
    <h1>PhotoRestore</h1>
    <p class="hero-sub">
        Restauración de fotos con IA, directamente en tu navegador.
        Sin servidores: tu imagen nunca sale de tu dispositivo.
    </p>
</div>

<div class="glass-card anim-enter">
    <div class="dropzone" @ref="dropzoneRef">
        <InputFile class="dropzone-input" OnChange="CargarImagen" accept="image/*" title="Selecciona una imagen" />
        <svg class="dz-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
        </svg>
        @if (imagenNombre is not null && imagenBytes is not null)
        {
            <p class="dz-file">@imagenNombre</p>
            <span class="dz-hint">@imagenAncho × @imagenAlto px · haz clic o suelta otra imagen para cambiar</span>
        }
        else
        {
            <p>Arrastra una imagen o haz clic para seleccionar</p>
            <span class="dz-hint">PNG, JPG, WebP… hasta 25 MB</span>
        }
    </div>
</div>

<div class="glass-card anim-enter">
    <span class="card-label">Factor de salida</span>
    <div class="scale-pills">
        @foreach (var f in new[] { 1, 2, 4 })
        {
            var valor = f;
            <label class="pill @(factor == valor ? "active" : "") @(ocupado ? "disabled" : "")">
                <input type="radio" name="factor" value="@valor" checked="@(factor == valor)"
                       disabled="@ocupado" @onchange="() => factor = valor" />
                @EtiquetaFactor(valor)
            </label>
        }
    </div>
    @if (imagenAncho > 0)
    {
        <p class="output-hint">Salida: <strong>@(imagenAncho * factor) × @(imagenAlto * factor) px</strong></p>
    }
</div>

<button class="btn-restore" @onclick="Restaurar" disabled="@(imagenBytes is null || ocupado)">
    @(ocupado ? "Procesando…" : "Restaurar")
</button>

@if (ocupado)
{
    <div class="glass-card processing-card fade-in">
        <lottie-player src="lottie/loading.json" autoplay loop
                       style="width: 140px; height: 105px;"></lottie-player>
        <p class="status-text" role="status">@estado</p>
        @if (tilesTotal > 0)
        {
            <div class="progress-track">
                <div class="progress-fill" style="width: @(100 * tilesDone / tilesTotal)%"></div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="glass-card error-card fade-in">@error</div>
}

@if (resultUrl is not null && originalUrl is not null)
{
    <div class="glass-card result-card fade-in">
        <span class="card-label">Resultado</span>
        <div class="comparison-wrap">
            <img-comparison-slider>
                <img slot="first" src="@originalUrl" alt="Imagen original" />
                <img slot="second" src="@resultUrl" alt="Imagen restaurada" />
            </img-comparison-slider>
            <span class="cmp-label before">Antes</span>
            <span class="cmp-label after">Después</span>
        </div>
        <p class="result-meta">
            <strong>@resultWidth × @resultHeight px</strong> · x@factor
            @if (!string.IsNullOrEmpty(backend))
            {
                <span class="backend-badge @(backend == "webgpu" ? "webgpu" : "")">
                    Motor: @(backend == "webgpu" ? "WebGPU" : "WASM (CPU)")
                </span>
            }
        </p>
        <a class="btn-download" href="@resultUrl" download="@NombreDescarga">Descargar resultado</a>
    </div>
}

<footer class="page-footer">
    Tu imagen nunca sale de tu dispositivo · Real-ESRGAN · ONNX Runtime Web
</footer>

@code {
    private const long MaxFileSize = 25 * 1024 * 1024; // 25 MB

    private IJSObjectReference? module;
    private IJSObjectReference? uiModule;
    private DotNetObjectReference<Restore>? progressRef;
    private ElementReference dropzoneRef;

    private byte[]? imagenBytes;
    private string? imagenMime;
    private string? imagenNombre;
    private int imagenAncho;
    private int imagenAlto;
    private int factor = 1;
    private string? originalUrl;
    private string? resultUrl;
    private int resultWidth;
    private int resultHeight;
    private string? backend;
    private string? estado;
    private string? error;
    private int tilesDone;
    private int tilesTotal;
    private bool ocupado;

    private string NombreDescarga =>
        $"{Path.GetFileNameWithoutExtension(imagenNombre ?? "imagen")}-x{factor}.png";

    private static string EtiquetaFactor(int f) => f switch
    {
        1 => "x1 · mismo tamaño",
        2 => "x2",
        _ => "x4 · máximo detalle"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/upscaler.js");
            uiModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
            progressRef = DotNetObjectReference.Create(this);

            await uiModule.InvokeVoidAsync("initAnimations");
            await uiModule.InvokeVoidAsync("initDropzone", dropzoneRef);
        }
    }

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        error = null;
        resultUrl = null;
        backend = null;
        estado = null;
        imagenBytes = null;
        imagenNombre = null;
        imagenAncho = 0;
        imagenAlto = 0;

        var file = e.File;
        if (!file.ContentType.StartsWith("image/"))
        {
            error = "Formato no soportado: selecciona un archivo de imagen.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            imagenBytes = ms.ToArray();
            imagenMime = file.ContentType;
            imagenNombre = file.Name;

            if (module is not null)
            {
                if (originalUrl is not null)
                    await module.InvokeVoidAsync("revokeObjectUrl", originalUrl);
                originalUrl = await module.InvokeAsync<string>("createObjectUrl", imagenBytes, imagenMime);

                var size = await module.InvokeAsync<ImageSize>("getImageSize", imagenBytes, imagenMime);
                imagenAncho = size.Width;
                imagenAlto = size.Height;
            }
        }
        catch (Exception ex)
        {
            error = $"No se pudo leer la imagen: {ex.Message}";
            imagenBytes = null;
            imagenNombre = null;
        }
    }

    private async Task Restaurar()
    {
        if (module is null || progressRef is null || imagenBytes is null)
            return;

        ocupado = true;
        error = null;
        resultUrl = null;
        tilesDone = 0;
        tilesTotal = 0;
        estado = "Cargando modelo Real-ESRGAN…";

        try
        {
            var result = await module.InvokeAsync<UpscaleResult>("upscale", imagenBytes, imagenMime, progressRef, factor);
            resultUrl = result.ResultUrl;
            backend = result.Backend;
            resultWidth = result.Width;
            resultHeight = result.Height;
        }
        catch (Exception ex)
        {
            error = $"Error durante la restauración: {ex.Message}";
        }
        finally
        {
            ocupado = false;
            estado = null;
        }
    }

    [JSInvokable]
    public void OnTileDone(int done, int total)
    {
        tilesDone = done;
        tilesTotal = total;
        estado = $"Procesando tile {done} de {total}";
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        progressRef?.Dispose();
        try
        {
            if (module is not null)
                await module.DisposeAsync();
            if (uiModule is not null)
                await uiModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // El circuito/JS ya no está disponible al cerrar la página.
        }
    }

    private sealed class ImageSize
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }

    private sealed class UpscaleResult
    {
        public string ResultUrl { get; set; } = "";
        public string Backend { get; set; } = "";
        public int Width { get; set; }
        public int Height { get; set; }
    }
}
